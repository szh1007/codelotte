# codelotte serve 配置模板：复制为 deploy/.env 后按需修改。
# 这些值只服务本地开发；共享或生产环境必须全部覆盖。
# 默认值与 compose、src/codelotte/serve/config.py 的默认值完全一致，复制后无需改动即可跑通。
# 若要改密码，CODELOTTE_PG_DSN 里的密码必须与 POSTGRES_PASSWORD 一起改，否则容器起来了也连不上。

# --- 中间件连接（宿主机视角）---
# 宿主端口统一加 1 前缀（16379 / 19092 / 15432），避开本机已装的同类服务
CODELOTTE_REDIS_URL=redis://localhost:16379/0
CODELOTTE_KAFKA_BOOTSTRAP=localhost:19092
# 宿主机端口是 15432：本机原生 PostgreSQL 通常占着 5432
CODELOTTE_PG_DSN=postgresql://codelotte:codelotte-dev@localhost:15432/codelotte

# --- PostgreSQL 容器初始化 ---
POSTGRES_USER=codelotte
# 开发默认值；任何共享或生产环境必须替换
POSTGRES_PASSWORD=codelotte-dev
POSTGRES_DB=codelotte

# --- 限流：令牌桶 ---
CODELOTTE_RATE_LIMIT_PER_MINUTE=60
CODELOTTE_RATE_LIMIT_BURST=20

# --- 配额：整数「分」 ---
CODELOTTE_DAILY_QUOTA_CENTS=1000

# --- 背压：Kafka consumer lag 超过该值即返回 503 ---
CODELOTTE_QUEUE_LAG_THRESHOLD=10000

# --- 会话 entries 的共享目录（api 与 worker 必须指向同一处）---
CODELOTTE_SESSION_ROOT=/data/sessions
